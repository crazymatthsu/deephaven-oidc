  <diagram id="keycloak-entra-broker-pro" name="Keycloak Entra Broker - EKS Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Authentication Architecture: Keycloak as OIDC Broker to Microsoft Entra ID" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#232F3E;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1200" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="AWS EKS Deployment  |  Deephaven Community Core  |  Single Logical Identity Provider" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#545B64;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="200" y="52" width="1200" height="24" as="geometry" />
        </mxCell>

        <!-- ========== LEFT: External Clients ========== -->
        <mxCell id="clients-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#D5DBDB;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="260" height="480" as="geometry" />
        </mxCell>
        <mxCell id="clients-header" value="External Clients" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#232F3E;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="55" y="110" width="200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="browser" value="<b>Browser</b><br>Deephaven Web IDE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B74C4;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="150" width="210" height="56" as="geometry" />
        </mxCell>

        <mxCell id="subscriber" value="<b>OrderSubscriber</b><br>Barrage Client (Java)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B74C4;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="230" width="210" height="56" as="geometry" />
        </mxCell>

        <mxCell id="simulator" value="<b>OrderSimulator</b><br>Service Account Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B74C4;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="310" width="210" height="56" as="geometry" />
        </mxCell>

        <mxCell id="client-note" value="Interactive users use&#xa;Authorization Code + PKCE.&#xa;Service accounts use&#xa;Client Credentials grant." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="65" y="390" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- ========== CENTER: EKS ========== -->
        <mxCell id="eks-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#FF9900;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="620" height="720" as="geometry" />
        </mxCell>
        <mxCell id="eks-header" value="AWS EKS Cluster   ·   namespace: deephaven" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="360" y="110" width="400" height="26" as="geometry" />
        </mxCell>

        <!-- ALB -->
        <mxCell id="alb" value="<b>Application Load Balancer</b><br>TLS Termination (ACM)  ·  gRPC / HTTP2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#D46B08;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="150" width="540" height="52" as="geometry" />
        </mxCell>

        <!-- Keycloak section -->
        <mxCell id="kc-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="230" width="540" height="230" as="geometry" />
        </mxCell>
        <mxCell id="kc-header" value="Keycloak  —  OIDC Broker" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#5A2D9C;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="300" height="24" as="geometry" />
        </mxCell>

        <mxCell id="kc-pods" value="<b>Keycloak Pods</b><br>Replicas: 2–3<br>Cache: ispn + jdbc-ping<br>Shared RDS PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EBFF;strokeColor=#8C4FFF;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="kc-realm" value="<b>Realm: deephaven_core</b><br>• Clients: deephaven, order-simulator<br>• Roles: trader-us, trader-emea, dh-admin, writer<br>• Identity Provider: Microsoft Entra ID<br>• Token issuer for all Deephaven clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EBFF;strokeColor=#8C4FFF;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="280" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="kc-note" value="Keycloak is the single identity provider trusted by Deephaven. It federates authentication to Entra ID and issues its own tokens." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5A2D9C;fontFamily=Arial;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="410" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- Deephaven section -->
        <mxCell id="dh-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B74C4;strokeWidth=2;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="490" width="540" height="300" as="geometry" />
        </mxCell>
        <mxCell id="dh-header" value="Deephaven Community Core" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#0B5CAB;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="400" y="500" width="300" height="24" as="geometry" />
        </mxCell>

        <mxCell id="dh-pods" value="<b>Deephaven Pods</b><br>Replicas: 1–3 (independent engines)<br>OIDC Authentication Handler<br>Validates tokens against Keycloak only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#1B74C4;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="dh-config" value="<b>Server Configuration</b><br>AuthHandlers =<br>  io.deephaven.authentication.oidc.<br>  OidcAuthenticationHandler<br><br>authentication.oidc.keycloak.url<br>  = https://auth.&lt;domain&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#1B74C4;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="540" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="dh-note" value="Deephaven never communicates directly with Entra ID. All token validation uses Keycloak’s issuer and JWKS endpoint." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#0B5CAB;fontFamily=Arial;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="720" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- ========== RIGHT: Entra ID ========== -->
        <mxCell id="entra-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#D5DBDB;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="280" height="380" as="geometry" />
        </mxCell>
        <mxCell id="entra-header" value="Microsoft Entra ID" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#232F3E;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1015" y="110" width="200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="entra-tenant" value="<b>Entra Tenant</b><br>(Azure AD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C23934;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1025" y="150" width="230" height="56" as="geometry" />
        </mxCell>

        <mxCell id="entra-app" value="<b>App Registration</b><br>OIDC / OAuth 2.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C23934;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1025" y="230" width="230" height="56" as="geometry" />
        </mxCell>

        <mxCell id="entra-roles" value="<b>Users · Groups · App Roles</b>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C23934;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1025" y="310" width="230" height="48" as="geometry" />
        </mxCell>

        <mxCell id="entra-note" value="Corporate identity source of truth. Keycloak federates to this tenant for interactive login." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1025" y="380" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- ========== Flow Legend ========== -->
        <mxCell id="legend-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#D5DBDB;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1000" y="510" width="280" height="310" as="geometry" />
        </mxCell>
        <mxCell id="legend-header" value="Authentication Flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#232F3E;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1015" y="520" width="200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="flow-text" value="<font style='font-size:11px'><b>1.</b> User opens Deephaven IDE<br><br><b>2.</b> Keycloak redirects to Entra ID<br>(OIDC federation)<br><br><b>3.</b> User authenticates at Entra;<br>claims returned to Keycloak<br><br><b>4.</b> Keycloak issues access token<br>(mapped realm roles)<br><br><b>5.</b> Client presents Keycloak token<br>to Deephaven<br><br><b>6.</b> Deephaven validates token<br>against Keycloak (issuer + JWKS)</font>" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1015" y="550" width="250" height="250" as="geometry" />
        </mxCell>

        <!-- ========== Arrows ========== -->

        <!-- 1. Browser -> ALB -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1B74C4;endArrow=block;endFill=1;" edge="1" parent="1" source="browser" target="alb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. Keycloak -> Entra -->
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#C23934;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="kc-pods" target="entra-tenant">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="960" y="325" />
              <mxPoint x="960" y="178" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 3. Entra -> Keycloak -->
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#C23934;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="entra-tenant" target="kc-realm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="178" />
              <mxPoint x="980" y="335" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 5. Browser -> Deephaven (token presentation) -->
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1B74C4;endArrow=block;endFill=1;" edge="1" parent="1" source="browser" target="dh-pods">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="178" />
              <mxPoint x="320" y="590" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Simulator to Keycloak -->
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#8C4FFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="simulator" target="kc-pods">
          <mxGeometry relative="1" as="geometry">
