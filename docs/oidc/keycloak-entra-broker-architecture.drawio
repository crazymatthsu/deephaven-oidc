        <!-- ALB / Ingress -->
        <mxCell id="alb" value="Application Load Balancer (ALB)&#xa;+ Ingress&#xa;TLS termination (ACM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="140" width="360" height="70" as="geometry" />
