{
  "realm": "deephaven_core",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      { "name": "dh-admin", "description": "Entitled to orders in all regions" },
      { "name": "trader-us", "description": "Entitled to US orders" },
      { "name": "trader-emea", "description": "Entitled to EMEA orders" },
      { "name": "writer", "description": "May publish rows into the orders table" }
    ]
  },
  "clients": [
    {
      "clientId": "deephaven",
      "name": "Deephaven web IDE and user-facing clients",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:10000/*",
        "http://127.0.0.1:10000/*"
      ],
      "webOrigins": ["+"]
    },
    {
      "clientId": "order-simulator",
      "name": "Order simulator service account",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "order-simulator-secret",
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Adams",
      "email": "alice@example.com",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["trader-us"]
    },
    {
      "username": "bob",
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Baker",
      "email": "bob@example.com",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["trader-emea"]
    },
    {
      "username": "carol",
      "enabled": true,
      "firstName": "Carol",
      "lastName": "Chen",
      "email": "carol@example.com",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }],
      "realmRoles": ["dh-admin"]
    },
    {
      "username": "service-account-order-simulator",
      "enabled": true,
      "serviceAccountClientId": "order-simulator",
      "realmRoles": ["writer"]
    }
  ]
}
