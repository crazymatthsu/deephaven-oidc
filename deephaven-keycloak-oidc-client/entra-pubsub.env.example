# Credentials for the deephaven-pub-sub daemon (OrderSimulator, client-credentials grant).
# Copy to entra-pubsub.env (gitignored), fill in, then run:
#   set -a; source deephaven-keycloak-oidc-client/entra-pubsub.env; set +a
#   ./gradlew :deephaven-keycloak-oidc-client:runSimulator
AUTH_PROVIDER=entra
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# deephaven-pub-sub app registration client ID (NOT deephaven-users)
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Secret from deephaven-pub-sub -> Certificates & secrets (the Value, shown once)
ENTRA_CLIENT_SECRET=
# .default resolves to the admin-consented application permissions (the `writer` app role)
ENTRA_SCOPE=api://<deephaven-api-client-id>/.default
