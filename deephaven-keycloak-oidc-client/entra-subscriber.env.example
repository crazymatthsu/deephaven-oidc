# Environment for human sign-in (OrderSubscriber, device-code flow + Authenticator MFA).
# Copy to entra-subscriber.env (gitignored), fill in, then run:
#   set -a; source deephaven-keycloak-oidc-client/entra-subscriber.env; set +a
#   ./gradlew :deephaven-keycloak-oidc-client:runSubscriber
# No password/secret here — identity comes from whoever completes the browser sign-in.
AUTH_PROVIDER=entra
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# deephaven-users app registration client ID (public client; NOT deephaven-pub-sub)
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_SCOPE=api://<deephaven-api-client-id>/access_as_user
# devicecode (default) | interactive | ropc
ENTRA_USER_FLOW=devicecode
