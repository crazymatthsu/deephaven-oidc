# Copy to .env (next to compose.yaml) or export in your shell before `scripts/start.sh entra`.
# Values come from your Entra ID app registrations — see docs/oidc/ENTRA-IMPLEMENTATION-PLAN.md
# Phase 4 for the full portal setup guide.

# Directory (tenant) ID of your Entra tenant.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Expected audience of presented access tokens. With requestedAccessTokenVersion=2 on the API
# app (required — see the tenant setup guide), v2 tokens carry the API app's BARE client id in
# `aud`, so use the plain GUID here (NOT the api://... form) — confirmed in live testing.
ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000

# Comma-separated role claims admitted as Deephaven SuperUser; all other valid tokens get a
# per-user context carrying their identity and roles.
ENTRA_SUPERUSER_ROLES=dh-admin

# --- Browser IDE login (optional; enterprise SSO + Microsoft Authenticator MFA) ---
# Client ID of the SPA platform app registration. Its redirect URI must exactly match the IDE
# URL, e.g. http://localhost:10000/ide/ locally. Leave empty for gRPC-only use.
ENTRA_SPA_CLIENT_ID=

# Delegated scope the web UI requests, e.g. api://<app-id-uri>/access_as_user
ENTRA_WEB_SCOPE=
