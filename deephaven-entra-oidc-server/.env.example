# Copy to .env (next to compose.yaml) or export in your shell before `scripts/start.sh entra`.
# Values come from your Entra ID app registrations — see docs/oidc/ENTRA-IMPLEMENTATION-PLAN.md
# Phase 4 for the full portal setup guide.

# Directory (tenant) ID of your Entra tenant.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Expected audience of presented access tokens: the API app's Application ID URI
# (api://<client-id>) or its client ID.
ENTRA_AUDIENCE=api://00000000-0000-0000-0000-000000000000
